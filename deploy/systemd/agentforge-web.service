[Unit]
Description=AgentForge-RS Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/agentforge-rs
Environment=STATIC_DIR=/root/agentforge-rs/static
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/agentforge web --port 3100
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
