//! Sub-agent pool — manages Claude Code / Codex fix invocations.
//!
//! Each agent gets its own Git worktree for isolated fixes.

use std::process::Command;
use std::time::Instant;

/// Result of invoking Claude Code for a bug fix.
#[derive(Debug, Clone)]
pub struct ClaudeResult {
    pub success: bool,
    pub bug_id: String,
    pub elapsed_ms: u64,
    pub stdout: String,
    pub stderr: String,
    pub exit_code: i32,
    pub changes: u32,
}

/// Check if a bug is a frontend issue (should use Codex).
pub fn is_frontend_bug(title: &str) -> bool {
    let t = title.to_lowercase();
    let frontend_kw = ["前端", "vue", "界面", "显示", "弹窗", "按钮", "列表", "回显",
                       "刷新", "排版", "格式", "样式", "css", "组件", "命名", "提示语",
                       "查询", "过滤", "加载", "报表", "报表管理"];
    frontend_kw.iter().any(|kw| t.contains(kw))
}

/// Run Codex to fix a bug (used for frontend or CC fallback).
fn run_codex_fix_impl(
    agent_name: &str,
    bug_id: &str,
    bug_title: &str,
    _timeout_secs: u64,
) -> ClaudeResult {
    let start = Instant::now();
    // 查询禅道 Bug 详情（含附件、步骤、批注）
    let bug_details = Command::new("bash")
        .arg("/root/.openclaw/extensions/zentao-token-refresh/zentao-bug-query.sh")
        .arg(bug_id)
        .output();
    let bug_details_text = match &bug_details {
        Ok(o) if o.status.success() => String::from_utf8_lossy(&o.stdout).to_string(),
        _ => {
            // Token expired -- retry once
            let _ = std::fs::remove_file("/tmp/.zentao-admin-token");
            Command::new("bash")
                .arg("/root/.openclaw/extensions/zentao-token-refresh/zentao-bug-query.sh")
                .arg(bug_id)
                .output()
                .ok()
                .and_then(|o| if o.status.success() {
                    Some(String::from_utf8_lossy(&o.stdout).to_string())
                } else { None })
                .unwrap_or_default()
        }
    };

    // Load karpathy-guidelines skill into prompt
    let skill_text = std::fs::read_to_string("/root/.codex/skills/karpathy-guidelines/SKILL.md")
        .unwrap_or_default();
    let prompt = format!(
        "你是一个中文编程助手。使用简体中文思考和回复。\n\n{}\n\n---\n修复 Bug #{}：{}\n\n## 禅道 Bug 详情\n{}\n\n## 修复指引（TDD 流程）\n1. 从 Bug 详情中的「Suggested Code Search Keywords」选取关键词，用 rg/grep 搜索相关代码\n2. 按「Steps to Reproduce」复现问题，找到根因\n3. **先写回归测试**：打开 tests/e2e/specs/bug-regression.spec.ts，在文件末尾新增 test('#{} 问题 @bug{} @regression', async ...)，用 Playwright 模拟复现步骤断言 Bug 行为\n4. **再修代码**：按「Expected Behavior」实现正确行为\n5. **验证测试**：运行 npx playwright test --grep @bug{} 确认通过；如失败则继续修\n6. 截图链接可以 curl 查看\n请分析并直接修改文件修复。不要用 git。",
        skill_text, bug_id, bug_title, bug_details_text, bug_id, bug_id, bug_id
    );
    let mut child = match Command::new("codex")
        .args(["exec", "--sandbox", "workspace-write", "--dangerously-bypass-approvals-and-sandbox", "--skip-git-repo-check", "-"])
        .current_dir("/root/.openclaw/workspace/his-repo")
        .stdin(std::process::Stdio::piped())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::piped())
        .spawn() {
        Ok(c) => c,
        Err(e) => return ClaudeResult {
            success: false, bug_id: bug_id.to_string(), elapsed_ms: start.elapsed().as_millis() as u64,
            stdout: String::new(), stderr: format!("codex spawn: {}", e), exit_code: -1, changes: 0,
        },
    };
    use std::io::Write;
    if let Some(mut stdin) = child.stdin.take() {
        let _ = stdin.write_all(prompt.as_bytes());
    }
    let output = child.wait_with_output();
    let elapsed = start.elapsed().as_millis() as u64;
    match output {
        Ok(o) => {
            let stdout = String::from_utf8_lossy(&o.stdout).to_string();
            let stderr = String::from_utf8_lossy(&o.stderr).to_string();
            let exit_code = o.status.code().unwrap_or(-1);
            let changes = count_worktree_changes(agent_name);
            let has_fix_commit = has_recent_fix_commit(agent_name, bug_id);
            let success = has_fix_commit || (
                exit_code == 0 && (
                    stdout.contains("修复完成") || stdout.contains("fix") || stdout.contains("resolved")
                    || changes > 0
                )
            );
            // Auto-commit codex changes (exclude temp files)
            if success && changes > 0 {
                let repo = "/root/.openclaw/workspace/his-repo";
                let _ = Command::new("git")
                    .args(["-C", repo, "add", "--all", "--", ":!*.orig", ":!*.mjs", ":!*.timestamp*"]).output();
                let _ = Command::new("git")
                    .args(["-C", repo, "commit", "-m", &format!("fix: #{} (codex)", bug_id)]).output();
            }
            ClaudeResult { success, bug_id: bug_id.to_string(), elapsed_ms: elapsed, stdout, stderr, exit_code, changes }
        }
        Err(e) => ClaudeResult {
            success: false, bug_id: bug_id.to_string(), elapsed_ms: elapsed,
            stdout: String::new(), stderr: format!("codex wait: {}", e), exit_code: -1, changes: 0,
        },
    }
}

/// Sync wrapper for Codex fix.
pub fn run_codex_fix_sync(
    agent_name: &str,
    bug_id: &str,
    bug_title: &str,
    timeout_secs: u64,
) -> ClaudeResult {
    run_codex_fix_impl(agent_name, bug_id, bug_title, timeout_secs)
}

/// Synchronous version — safe for `tokio::task::block_in_place`.
pub fn run_claude_fix_sync(
    agent_name: &str,
    bug_id: &str,
    bug_title: &str,
    claude_fix_script: &str,
    timeout_secs: u64,
) -> ClaudeResult {
    run_claude_fix_impl(agent_name, bug_id, bug_title, claude_fix_script, timeout_secs)
}

/// Async wrapper (uses sync internally, safe for spawn_blocking or block_in_place).
pub async fn run_claude_fix(
    agent_name: &str,
    bug_id: &str,
    bug_title: &str,
    claude_fix_script: &str,
    timeout_secs: u64,
) -> ClaudeResult {
    run_claude_fix_impl(agent_name, bug_id, bug_title, claude_fix_script, timeout_secs)
}

/// Invoke Claude Code to fix a bug using the agent's isolated worktree.
fn run_claude_fix_impl(
    agent_name: &str,
    bug_id: &str,
    bug_title: &str,
    claude_fix_script: &str,
    _timeout_secs: u64,
) -> ClaudeResult {
    let start = Instant::now();

    // Build shell command
    let output = Command::new("bash")
        .arg(claude_fix_script)
        .arg(bug_id)
        .arg(bug_title)
        .arg(agent_name)
        .output();

    let elapsed = start.elapsed().as_millis() as u64;

    match output {
        Ok(o) => {
            let stdout = String::from_utf8_lossy(&o.stdout).to_string();
            let stderr = String::from_utf8_lossy(&o.stderr).to_string();
            let exit_code = o.status.code().unwrap_or(-1);
            // Success: worktree has a "Fix Bug #N" commit OR exit 0 with expected output
            let has_fix_commit = has_recent_fix_commit(agent_name, bug_id);
            let success = has_fix_commit || (
                exit_code == 0 && (
                    stdout.contains(&format!("Fix Bug #{}", bug_id))
                    || stdout.contains("已在之前修复")
                    || stdout.contains("已包含完整修复")
                )
            );

            // Count diff changes from worktree
            let changes = count_worktree_changes(agent_name);
            if success && !has_fix_commit && changes > 0 {
                // Fix was detected by exit code but has uncommitted changes
                // Auto-commit them
                let worktree = format!("/tmp/agentforge-worktrees/{}", agent_name);
                let _ = Command::new("git")
                    .args(["-C", &worktree, "add", "--all", "--", ":!*.orig", ":!*.mjs", ":!*.timestamp*"])
                    .output();
                let _ = Command::new("git")
                    .args(["-C", &worktree, "commit", "-m", &format!("Fix Bug #{}", bug_id)])
                    .output();
            }

            ClaudeResult {
                success,
                bug_id: bug_id.to_string(),
                elapsed_ms: elapsed,
                stdout,
                stderr,
                exit_code,
                changes,
            }
        }
        Err(e) => ClaudeResult {
            success: false,
            bug_id: bug_id.to_string(),
            elapsed_ms: elapsed,
            stdout: String::new(),
            stderr: format!("{:?}", e),
            exit_code: -1,
            changes: 0,
        },
    }
}

/// Count uncommitted changed lines in the agent's worktree.
fn count_worktree_changes(agent_name: &str) -> u32 {
    let worktree = format!("/tmp/agentforge-worktrees/{}", agent_name);
    // Count staged + unstaged (but not committed) changes
    // Uses `git diff --stat` (unstaged) + `git diff --cached --stat` (staged)
    // which shows the actual current fix's changes, not the last commit
    let stat_outputs = [
        Command::new("git").args(["diff", "--stat"]).current_dir(&worktree).output(),
        Command::new("git").args(["diff", "--cached", "--stat"]).current_dir(&worktree).output(),
    ];
    let mut total = 0u32;
    for output in stat_outputs {
        if let Ok(o) = output {
            let stdout = String::from_utf8_lossy(&o.stdout);
            for line in stdout.lines() {
                if let Some(pipe_pos) = line.find('|') {
                    let nums = &line[pipe_pos+1..];
                    total += nums.chars().filter(|&c| c == '+' || c == '-').count() as u32;
                }
            }
        }
    }
    total
}


/// Check if the agent's worktree has a NEW commit with "Fix Bug #N" message
/// (commits that are NOT already in origin/HEAD, i.e., made by this fix run).
fn has_recent_fix_commit(agent_name: &str, bug_id: &str) -> bool {
    let worktree = format!("/tmp/agentforge-worktrees/{}", agent_name);
    // Use --not --remotes to exclude commits already pushed to remote
    // This only finds commits made locally but not yet in any remote branch
    let output = Command::new("git")
        .args(["-C", &worktree, "log", "-1", "--oneline", "--not", "--remotes", "--grep", &format!("Fix Bug #{}", bug_id)])
        .output();
    if let Ok(o) = &output {
        let stdout = String::from_utf8_lossy(&o.stdout);
        if !stdout.trim().is_empty() {
            return true;
        }
    }
    // Also check: is HEAD different from origin/HEAD (meaning a new commit was made)?
    let head_output = Command::new("git")
        .args(["-C", &worktree, "rev-parse", "HEAD"])
        .output();
    let origin_head_output = Command::new("git")
        .args(["-C", &worktree, "rev-parse", "origin/HEAD"])
        .output();
    if let (Ok(h), Ok(oh)) = (&head_output, &origin_head_output) {
        let head = String::from_utf8_lossy(&h.stdout).trim().to_string();
        let origin_head = String::from_utf8_lossy(&oh.stdout).trim().to_string();
        if head != origin_head && !head.is_empty() && !origin_head.is_empty() {
            // HEAD moved - a new commit was made. Check if it has the right message.
            let msg_output = Command::new("git")
                .args(["-C", &worktree, "log", "-1", "--format=%s"])
                .output();
            if let Ok(mo) = &msg_output {
                let msg = String::from_utf8_lossy(&mo.stdout);
                return msg.contains(&format!("Fix Bug #{}", bug_id)) || msg.contains(&format!("#{}", bug_id));
            }
        }
    }
    false
}

/// Verify that a fix diff is meaningful (≥3 changed lines).
pub fn is_meaningful_fix(changes: u32) -> bool {
    changes >= 3
}

/// Compute elapsed duration as HH:MM:SS string.
pub fn fmt_duration(seconds: f64) -> String {
    let s = seconds as u64;
    let h = s / 3600;
    let m = (s % 3600) / 60;
    let ss = s % 60;
    if h > 0 {
        format!("{:02}:{:02}:{:02}", h, m, ss)
    } else {
        format!("{:02}:{:02}", m, ss)
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_is_meaningful_fix() {
        assert!(!is_meaningful_fix(0));
        assert!(!is_meaningful_fix(2));
        assert!(is_meaningful_fix(3));
        assert!(is_meaningful_fix(100));
    }

    #[test]
    fn test_fmt_duration() {
        assert_eq!(fmt_duration(0.0), "00:00");
        assert_eq!(fmt_duration(45.0), "00:45");
        assert_eq!(fmt_duration(125.0), "02:05");
        assert_eq!(fmt_duration(3661.0), "01:01:01");
    }
}
