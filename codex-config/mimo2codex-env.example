# mimo2codex 运行时配置
# 复制为 .env 后填入你的 API Key

# MiMo API Key（token-plan 用 tp- 前缀，按量计费用 sk- 前缀）
MIMO_API_KEY=${MIMO_API_KEY}

# MiMo API Base URL
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 默认 provider 和 model
MIMO2CODEX_DEFAULT_PROVIDER=mimo
MIMO2CODEX_DEFAULT_MODEL=mimo-v2.5

# 详细日志
MIMO2CODEX_VERBOSE=1
MIMO2CODEX_LOG_LEVEL=info

# Codex 兼容的 API Key（本地代理固定值）
OPENAI_API_KEY=mimo2codex-local
