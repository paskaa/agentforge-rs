redis:
  host: "127.0.0.1"
  port: 16379
  db: 0

llm:
  api_base: "https://your-api-base/v1"
  api_key: "${MIMO_API_KEY}"
  default_model: "mimo-v2.5"
  coding_model: "mimo-v2.5"
  fallback:
    api_base: "https://your-api-base/v1"
    api_key: "${MIMO_API_KEY}"
    default_model: "mimo-v2.5"
    coding_model: "mimo-v2.5"
    extra_models:
      - "mimo-v2.5"
      - "mimo-v2-flash"
      - "mimo-v2-pro"

feishu:
  app_id: "${FEISHU_APP_ID}"
  app_secret: "${FEISHU_APP_SECRET}"
  group_chat_id: "${FEISHU_GROUP_CHAT_ID}"

zentao:
  base_url: "https://your-zentao-instance"
  scripts_dir: "/path/to/zentao-token-refresh"
  token_file: "/path/to/zentao/.env"
  cli_path: "/usr/local/bin/zentao"
  username: "${ZENTAO_USERNAME}"
  password: "${ZENTAO_PASSWORD}"

database:
  host: "${DB_HOST}"
  port: 5432
  database: "postgresql"
  username: "${DB_USERNAME}"
  password: "${DB_PASSWORD}"

agents:
  zhugeliang:
    name: "诸葛亮"
    role: "架构师"
    expertise: ["架构", "设计", "方案"]
  liubei:
    name: "刘备"
    role: "项目经理"
    expertise: ["汇总", "管理", "分配"]
  guanyu:
    name: "关羽"
    role: "后端开发"
    expertise: ["java", "spring", "api"]
  zhaoyun:
    name: "赵云"
    role: "前端开发"
    expertise: ["vue", "前端", "界面"]
  xunyu:
    name: "荀彧"
    role: "DBA"
    expertise: ["数据库", "sql"]
  zhangfei:
    name: "张飞"
    role: "测试"
    expertise: ["测试", "bug"]
  huatuo:
    name: "华佗"
    role: "产品经理"
    expertise: ["产品", "需求"]
  chenlin:
    name: "陈琳"
    role: "文档专员"
    expertise: ["文档", "wiki"]

scheduler:
  enabled: true
  tasks_file: "./config/scheduler_tasks.json"
